# Global Academy Environment Configuration
# Copy this file to .env and fill in the values

# App
VITE_APP_NAME=Global Academy
VITE_APP_URL=https://globalacademy.com
VITE_API_BASE_URL=https://api.globalacademy.com/v1

# Payment Gateways (PUBLIC keys only — NEVER put secret keys here)
VITE_RAZORPAY_KEY=rzp_live_REPLACE_WITH_YOUR_KEY
VITE_STRIPE_PUBLIC_KEY=pk_live_REPLACE_WITH_YOUR_KEY
VITE_PAYPAL_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID

# Google (OAuth — public client ID only)
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID

# Analytics (public tracking IDs only)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX

# Feature flags
VITE_ENABLE_CHAT=false
VITE_ENABLE_PAYMENTS=false
VITE_ENABLE_GOOGLE_LOGIN=false

# NOTE: The following must NEVER be in any VITE_ variable (they would be exposed in the browser bundle):
# - Database passwords
# - Razorpay/Stripe/PayPal secret keys
# - JWT secrets
# - SMTP passwords
# - Any OAuth client secrets
# These belong ONLY in the server-side .env file.

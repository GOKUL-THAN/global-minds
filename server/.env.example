NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
# Optional comma-separated additional origins for production frontends/proxies.
# APP_ALLOWED_ORIGINS=https://global-minds-git-main-website-1cc7.vercel.app
DATABASE_DRIVER=sqlite
DATABASE_PATH=data/admin.sqlite
# For production, set DATABASE_DRIVER=postgres and provide DATABASE_URL.
# DATABASE_URL=postgresql://user:password@localhost:5432/global_academy
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_14_CHARACTERS
SUPER_ADMIN_EMAIL=globalminds@gmail.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_PASSWORD_AT_LEAST_14_CHARACTERS
# Required for registration, email verification, and password recovery.
# Set APP_ORIGIN to the actual frontend origin used to build account links.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Global Minds Academy <accounts@example.com>
